<%- include('../partials/header.ejs') %>

<div class="container py-4">
  <div class="col-lg-8 mx-auto">
    <h1 class="display-5 fw-bold mb-4">About ExPress</h1>

    <p class="lead text-body-secondary">
      A place to share ideas, document learning, and express thoughts through
      writing.
    </p>

    <hr class="my-4" />

    <p>
      ExPress was built as a simple posting platform where articles can be
      written, edited, and shared in a clean and distraction-free environment.
    </p>

    <p>
      Whether it's programming, technology, personal projects, or lessons
      learned along the way, ExPress is designed to make publishing thoughts
      quick and enjoyable.
    </p>

    <p>
      The name <strong>ExPress</strong> comes from the idea of
      <em>expressing yourself</em> through writing while also serving as a small
      nod to the Express.js framework that powers the application.
    </p>

    <div class="card bg-body-tertiary border-0 mt-5">
      <div class="card-body">
        <h5 class="card-title">Built With</h5>
        <p class="card-text mb-0">Node.js • Express.js • EJS • Bootstrap</p>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer.ejs') %>
