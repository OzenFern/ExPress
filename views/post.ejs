<%- include('partials/header.ejs') %> <%- include('partials/warning.ejs') %>

<div class="container py-4">
  <a href="/posts" class="btn btn-outline-secondary mb-4"
    ><svg
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      fill="currentColor"
      class="bi bi-arrow-left"
      viewBox="0 0 16 16"
    >
      <path
        fill-rule="evenodd"
        d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"
      />
    </svg>
    Back to Posts</a
  >

  <article class="col-lg-8 mx-auto">
    <div class="mb-5">
      <h1 class="display-5 fw-bold"><%= post.title %></h1>

      <p class="lead text-body-secondary"><%= post.blurb %></p>

      <hr />
    </div>

    <div class="post-content fs-5"><%= post.content %></div>

    <hr class="my-5" />

    <div class="d-flex gap-2">
      <a href="/posts/<%= post.id %>/edit" class="btn btn-outline-info">
        Edit Post
      </a>

      <a href="/posts/<%= post.id %>/delete" class="btn btn-outline-danger">
        Delete Post
      </a>
    </div>
  </article>
</div>

<%- include('partials/footer.ejs') %>
