<%- include('partials/header.ejs') %>

<h1 class="pb-5">All Posts</h1>

<% if (locals.blogs && blogs.length === 0) { %> 

<div class="container">
  <div class="p-5 text-center bg-body-tertiary rounded-3">
    <h2 class="text-body-emphasis">No posts yet</h2>
    <p class="col-lg-8 mx-auto fs-5 text-muted">
      Start writing your first blog post and it will appear here.
    </p>
    <div class="d-inline-flex gap-2">
      <a
        class="d-inline-flex align-items-center btn btn-primary btn-lg px-4 rounded-pill"
        href="/posts/new"
      >
        Create new blog
      </a>
    </div>
  </div>
</div>
 
<% } else { %> 
 
<div class="row g-4">
  <% blogs.forEach(blog => { %>
    <div class="col-sm-6 d-flex">
    <div class="card h-100 w-100">
    <div class="card-body d-flex flex-column">
        <h4 class="card-title"><%= blog.title %></h4>
        <p class="card-text"><%= blog.blurb %></p>
        <div class="mt-auto d-inline-flex gap-3">
        <a href="/posts/<%= blog.id %>" class="btn btn-primary">View Full Post</a>
        <a href="/posts/<%= blog.id %>/delete" class="btn btn-outline-danger">Delete Post</a>
        </div>
    </div>
    </div>
  </div>
<%  }); %> 
</div>

<% }; %>

<%- include('partials/footer.ejs') %>
