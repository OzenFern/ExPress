<%- include('partials/header.ejs') %>

<h1 class="pb-5">All Posts</h1>

<% if (locals.title && locals.action) { %>

  <div
  class="alert alert-success alert-dismissible fade show d-flex align-items-center my-4"
  role="alert"
>
  <svg
    class="bi flex-shrink-0 me-3"
    width="20"
    height="20"
    fill="currentColor"
    viewBox="0 0 16 16"
    role="img"
    aria-label="Success:"
  >
    <path
      d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"
    />
  </svg>

  <div>"<strong><%= title %></strong>" post <%= action %>d successfully!</div>

  <button
    type="button"
    class="btn-close"
    data-bs-dismiss="alert"
    aria-label="Close"
  ></button>
</div>


<% }; %>

<% if (locals.blogs && blogs.length === 0) { %> 

<div class="container">
  <div class="p-5 text-center bg-body-tertiary rounded-3">
    <h2 class="text-body-emphasis">No posts yet</h2>
    <p class="col-lg-8 mx-auto fs-5 text-muted">
      Start writing your first blog post and it will appear here.
    </p>
    <div class="d-inline-flex gap-2">
      <a
        class="d-inline-flex align-items-center btn btn-primary btn-lg px-4 rounded-pill"
        href="/posts/new"
      >
        Create new blog
      </a>
    </div>
  </div>
</div>
 
<% } else { %> 
 
<div class="row g-4">
  <% blogs.forEach(blog => { %>
    <div class="col-sm-6 d-flex">
    <div class="card h-100 w-100">
    <div class="card-body d-flex flex-column">
        <h4 class="card-title"><%= blog.title %></h4>
        <p class="card-text"><%= blog.blurb %></p>
        <div class="mt-auto d-inline-flex gap-3">
        <a href="/posts/<%= blog.id %>" class="btn btn-primary">View Full Post</a>
        <a href="/posts/<%= blog.id %>/delete" class="btn btn-outline-danger">Delete Post</a>
        </div>
    </div>
    </div>
  </div>
<%  }); %> 
</div>

<% }; %>

<%- include('partials/footer.ejs') %>
