<%- include('partials/header.ejs') %>

<h1 class="pb-5">All Posts</h1>

<% if (locals.title && locals.action) { %>
    <%-include("../partials/flash-message.ejs"), { title, action } %>
<% } %>

<% if (locals.posts && posts.length === 0) { %> 

<div class="container my-5">
  <div class="p-5 text-center bg-body-tertiary rounded-3">
    <h2 class="text-body-emphasis">No posts yet</h2>
    <p class="col-lg-8 mx-auto fs-5 text-muted">
      Start writing your first post and it will appear here.
    </p>
    <div class="d-inline-flex gap-2">
      <a
        class="d-inline-flex align-items-center btn btn-primary btn-lg px-4 rounded-pill"
        href="/posts/new"
      >
        Create new post
      </a>
    </div>
  </div>
</div>
 
<% } else { %> 
 
<div class="row g-4">
  <% posts.forEach(post => { %>
    <div class="col-sm-6 d-flex">
    <div class="card h-100 w-100">
    <div class="card-body d-flex flex-column">
        <h4 class="card-title"><%= post.title %></h4>
        <p class="card-text"><%= post.blurb %></p>
        <div class="mt-auto d-flex flex-column flex-wrap flex-sm-row gap-3">
        <a href="/posts/<%= post.id %>" class="btn btn-primary flex-fill">View Post</a>
        <a href="/posts/<%= post.id %>/edit" class="btn btn-outline-info flex-fill">Edit Post</a>
        <%- include("partials/delete-modal.ejs", {
            post,
            buttonClass: 'flex-fill',
        }) %>

        </div>
    </div>
    </div>
  </div>
<%  }); %> 
</div>

<% } %>

<%- include('partials/footer.ejs') %>
