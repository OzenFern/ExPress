<div
        class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center my-4"
        role="alert"
>
    <svg
            class="bi flex-shrink-0 me-3"
            width="20"
            height="20"
            fill="currentColor"
            viewBox="0 0 16 16"
            role="img"
            aria-label="Success:"
    >
        <path
                d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"
        />
    </svg>

    <div>"<strong><%= title %></strong>" post <%= action %> successfully!</div>

    <button
            type="button"
            class="btn-close"
            data-bs-dismiss="alert"
            aria-label="Close"
    ></button>
</div>