<button type="button" class="button button-danger <%= buttonClass ?? '' %>" data-modal-open="#deletePost<%= post.id %>">Delete Post</button>
<div class="modal" id="deletePost<%= post.id %>" aria-hidden="true">
  <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="delete-title">
    <h3 id="delete-title">Delete this post?</h3>
    <p>“<strong><%= post.title %></strong>” will be removed permanently.</p>
    <div class="modal-actions">
      <button type="button" class="button button-secondary" data-modal-close>Keep it</button>
      <form action="/posts/<%= post.id %>/delete" method="POST"><button type="submit" class="button button-danger">Delete</button></form>
    </div>
  </div>
</div>
