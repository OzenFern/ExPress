<div class="form-shell">
  <div class="form-card">
    <form action=<%= action %> method="POST" class="needs-validation" novalidate id="post-form">
      <div class="field">
        <label for="post-title">Post title</label>
        <input type="text" id="post-title" name="title" placeholder="A thought worth keeping" required minlength="3" maxlength="100" value="<%= post?.title || '' %>" autofocus />
        <div class="field-meta"><span>Make it memorable</span><span><span id="title-count">0</span>/100</span></div>
        <div class="invalid-feedback">Title must be 3–100 characters long.</div>
      </div>
      <div class="field">
        <label for="post-blurb">Short description</label>
        <textarea id="post-blurb" name="blurb" placeholder="Give readers a reason to lean in" required minlength="10" maxlength="180" rows="3"><%= post?.blurb || '' %></textarea>
        <div class="field-meta"><span>The hook</span><span><span id="blurb-count">0</span>/180</span></div>
        <div class="invalid-feedback">Description must be 10–180 characters long.</div>
      </div>
      <div class="field">
        <label for="post-content">Post content</label>
        <textarea id="post-content" name="content" placeholder="Start writing..." required minlength="30" rows="12"><%= post?.content || '' %></textarea>
        <div class="field-meta"><span>Your perspective</span><span><span id="content-count">0</span> characters</span></div>
        <div class="invalid-feedback">Content must be at least 30 characters long.</div>
      </div>
      <button class="button button-primary button-block" type="submit" id="publish"><%= buttonText %> <span>↗</span></button>
    </form>
  </div>
</div>
