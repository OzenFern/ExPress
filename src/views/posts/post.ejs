<%- include('../partials/header.ejs') %>

<article class="reading-column">
  <a href="/posts" class="button button-secondary">← Back to archive</a>
  <header class="reading-header">
    <p class="post-meta">A considered perspective</p>
    <h1><%= post.title %></h1>
    <p><%= post.blurb %></p>
  </header>
  <div class="post-content"><%= post.content %></div>
  <div class="actions">
    <a href="/posts/<%= post.post_id %>/edit" class="button button-secondary">Edit post</a>
    <%- include("../partials/delete-modal.ejs", { post, buttonClass: '' }) %>
  </div>
</article>

<%- include('../partials/footer.ejs') %>
